---
import Layout from '../layouts/Layout.astro';

const workerUrl = import.meta.env.PUBLIC_WORKER_URL;
const isUploadEnabled = !!workerUrl;
---

<Layout
  title="Încarcă PDF | CuzaPages"
  description="Formular pentru încărcarea de documente PDF în arhiva de subiecte BAC și admitere — variante, bareme și simulări de la elevi pentru elevi."
  nofollow
  noindex
  bodyClass="mx-4"
>
  <div
    class="max-w-sm md:max-w-lg mx-auto bg-white p-6 rounded-lg shadow-lg absolute top-1/3 left-1/2 transform -translate-x-1/2 -translate-y-1/3"
  >
    <h1 class="text-center text-gray-800">
      Încarcă documentul PDF pentru <a
        href="https://cuza.pages.dev"
        class="text-blue-500">cuza.pages.dev</a
      > - <a href="https://github.com/DynoW" class="text-blue-500">DynoW</a>
    </h1>
    {
      !isUploadEnabled && (
        <div class="mt-4 p-4 bg-yellow-100 border border-yellow-400 text-yellow-800 rounded">
          <p class="font-bold">Upload momentan indisponibil</p>
          <p class="text-sm mt-2">
            Variabila de mediu{' '}
            <code class="bg-yellow-50 px-1">PUBLIC_WORKER_URL</code> nu este
            configurată. Contactează administratorul pentru a activa încărcarea
            de fișiere.
          </p>
        </div>
      )
    }
    {
      isUploadEnabled && (
        <form
          id="uploadForm"
          method="POST"
          enctype="multipart/form-data"
          class="flex flex-col gap-4 mt-4"
        >
          <div class="flex items-center gap-2">
            <label for="page" class="font-bold whitespace-nowrap">
              Pagina:
            </label>
            <select
              id="page"
              name="page"
              required
              class="p-2 border border-gray-300 rounded"
            >
              <option value="bac">Bac</option>
              <option value="sim">Simulări județene</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <label for="year" class="font-bold whitespace-nowrap">
              An:
            </label>
            <input
              type="number"
              id="year"
              name="year"
              required
              class="w-20 p-2 border border-gray-300 rounded"
            />
          </div>

          <div id="titleField" class="hidden items-center gap-2">
            <label for="title" class="font-bold whitespace-nowrap">
              Tip:
            </label>
            <select
              id="title"
              name="title"
              required
              class="p-2 border border-gray-300 rounded"
            >
              <option value="Model">Model</option>
              <option value="Simulare">Simulare</option>
              <option value="Sesiunea-I">Sesiunea I</option>
              <option value="Sesiunea-II">Sesiunea II</option>
              <option value="Sesiunea-speciala">Sesiunea Specială</option>
            </select>
          </div>

          <div id="variantField" class="hidden items-center gap-2">
            <label for="variant" class="font-bold whitespace-nowrap">
              Varianta:
            </label>
            <select
              id="variant"
              name="variant"
              class="p-2 border border-gray-300 rounded"
            >
              <option value="01">01</option>
              <option value="02">02</option>
              <option value="03">03</option>
              <option value="04">04</option>
              <option value="05">05</option>
              <option value="06">06</option>
              <option value="07">07</option>
              <option value="08">08</option>
              <option value="09">09</option>
              <option value="10">10</option>
            </select>
          </div>

          <div id="reserveField" class="hidden items-center gap-2">
            <label for="reserve" class="font-bold whitespace-nowrap">
              Este rezervă?
            </label>
            <input
              type="checkbox"
              id="reserve"
              name="reserve"
              class="h-4 w-4"
            />
          </div>

          <div id="simulationField" class="hidden items-center gap-2">
            <label for="simulation" class="font-bold whitespace-nowrap">
              Tip simulare:
            </label>
            <select
              id="simulation"
              name="simulation"
              class="p-2 border border-gray-300 rounded"
            >
              <option value="judetene">Județeană</option>
              <option value="locale">Locală</option>
            </select>
          </div>

          <div id="countyField" class="hidden items-center gap-2">
            <label for="county" class="font-bold whitespace-nowrap">
              Județ:
            </label>
            <select
              id="county"
              name="county"
              class="p-2 border border-gray-300 rounded"
            >
              <option value="Alba">Alba</option>
              <option value="Arad">Arad</option>
              <option value="Argeș">Argeș</option>
              <option value="Bacău">Bacău</option>
              <option value="Bihor">Bihor</option>
              <option value="Bistrița-Năsăud">Bistrița-Năsăud</option>
              <option value="Botoșani">Botoșani</option>
              <option value="Brașov">Brașov</option>
              <option value="Brăila">Brăila</option>
              <option value="Buzău">Buzău</option>
              <option value="Caraș-Severin">Caraș-Severin</option>
              <option value="Călărași">Călărași</option>
              <option value="Cluj">Cluj</option>
              <option value="Constanța">Constanța</option>
              <option value="Covasna">Covasna</option>
              <option value="Dâmbovița">Dâmbovița</option>
              <option value="Dolj">Dolj</option>
              <option value="Galați">Galați</option>
              <option value="Giurgiu">Giurgiu</option>
              <option value="Gorj">Gorj</option>
              <option value="Harghita">Harghita</option>
              <option value="Hunedoara">Hunedoara</option>
              <option value="Ialomița">Ialomița</option>
              <option value="Iași">Iași</option>
              <option value="Ilfov">Ilfov</option>
              <option value="Maramureș">Maramureș</option>
              <option value="Mehedinți">Mehedinți</option>
              <option value="Mureș">Mureș</option>
              <option value="Neamț">Neamț</option>
              <option value="Olt">Olt</option>
              <option value="Prahova">Prahova</option>
              <option value="Satu Mare">Satu Mare</option>
              <option value="Sălaj">Sălaj</option>
              <option value="Sibiu">Sibiu</option>
              <option value="Suceava">Suceava</option>
              <option value="Teleorman">Teleorman</option>
              <option value="Timiș">Timiș</option>
              <option value="Tulcea">Tulcea</option>
              <option value="Vaslui">Vaslui</option>
              <option value="Vâlcea">Vâlcea</option>
              <option value="Vrancea">Vrancea</option>
              <option value="București">București</option>
            </select>
          </div>

          <div id="localField" class="hidden flex-wrap items-center gap-2">
            <label for="local" class="font-bold whitespace-nowrap">
              Localitate/Liceu (poate fi: LAICUZA):
            </label>
            <input
              type="text"
              id="local"
              name="local"
              class="p-2 border border-gray-300 rounded w-40"
            />
          </div>

          <div class="flex items-center gap-2">
            <label class="font-bold whitespace-nowrap">Variantă/Barem:</label>
            <input type="hidden" id="type2" name="type2" value="var" />
            <label class="relative inline-flex h-9.5 w-36 cursor-pointer select-none items-center rounded border border-gray-300 p-1">
              <input id="type2Toggle" type="checkbox" class="peer sr-only" />
              <span class="absolute inset-y-1 left-1 w-94/200 rounded bg-blue-500 transition-transform duration-300 ease-out peer-checked:translate-x-full" />
              <span class="relative z-10 flex w-1/2 items-center justify-center text-sm font-semibold text-white transition-colors duration-300 peer-checked:text-slate-700">
                Var
              </span>
              <span class="relative z-10 flex w-1/2 items-center justify-center text-sm font-semibold text-slate-700 transition-colors duration-300 peer-checked:text-white">
                Bar
              </span>
            </label>
          </div>

          <div>
            <label for="file" class="font-bold">
              Selectează PDF:
            </label>
            <input
              type="file"
              id="file"
              name="file"
              accept="application/pdf"
              required
              class="w-full p-2 border border-gray-300 rounded mt-1"
            />
          </div>

          <button
            type="submit"
            class="bg-blue-500 text-white p-2 rounded mt-4 cursor-pointer hover:bg-blue-600"
          >
            Încarcă
          </button>
        </form>
      )
    }
    <div id="message" class="mt-4 text-center"></div>
  </div>

  <style is:global>
    input[type='file']::-webkit-file-upload-button {
      background-color: rgb(59, 130, 246);
      color: white;
      border: none;
      padding: 0.5rem 0.75rem;
      margin-right: 0.5rem;
      border-radius: 0.375rem;
      cursor: pointer;
    }

    input[type='file']::file-selector-button {
      background-color: rgb(59, 130, 246);
      color: white;
      border: none;
      padding: 0.5rem 0.75rem;
      margin-right: 0.5rem;
      border-radius: 0.375rem;
      cursor: pointer;
    }

    input[type='file'] {
      display: inline-block;
    }
  </style>

  <!-- The Modal -->
  {
    isUploadEnabled && (
      <div
        id="passwordModal"
        class="modal fixed inset-0 items-center justify-center bg-black/50 hidden"
      >
        <div class="modal-content bg-white p-6 rounded-lg shadow-lg w-80">
          <div class="modal-content-heading flex justify-between items-center">
            <label for="passwordInput" class="font-bold">
              Introdu parola
            </label>
            <span
              id="closeModalBtn"
              class="cursor-pointer text-gray-500 text-2xl font-bold"
            >
              &times;
            </span>
          </div>
          <input
            type="password"
            id="passwordInput"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            class="p-2 border border-gray-300 rounded mt-4"
          />
          <button
            id="submitPassword"
            class="bg-blue-500 text-white p-2 rounded mt-4 cursor-pointer hover:bg-blue-600"
          >
            Trimite
          </button>
        </div>
      </div>
    )
  }

  <script>
    const $ = (id: string): HTMLElement | null => document.getElementById(id);

    const setField = (container: HTMLElement | null, show: boolean): void => {
      if (!container) return;
      container.classList.toggle('hidden', !show);
      container.classList.toggle('flex', show);
    };

    const pageSelect = $('page') as HTMLSelectElement | null;
    let page = pageSelect?.value ?? '';
    const simulationSelect = $('simulation') as HTMLSelectElement | null;
    let simulation = simulationSelect?.value ?? '';
    const titleSelect = $('title') as HTMLSelectElement | null;
    let title = titleSelect?.value ?? '';

    const simulationField = $('simulationField');
    const countyField = $('countyField');
    const localField = $('localField');
    const titleField = $('titleField');
    const variantField = $('variantField');
    const reserveField = $('reserveField');
    const reserveInput = $('reserve') as HTMLInputElement | null;
    const type2Toggle = $('type2Toggle') as HTMLInputElement | null;
    const type2Input = $('type2') as HTMLInputElement | null;
    const yearInput = $('year') as HTMLInputElement | null;

    const VARIANT_TITLES = new Set([
      'Sesiunea-I',
      'Sesiunea-II',
      'Sesiunea-speciala',
    ]);

    function toggleFields(
      page: string,
      simulation: string,
      title?: string,
    ): void {
      if (page === 'bac') {
        setField(titleField, true);
        const showVariant = title ? VARIANT_TITLES.has(title) : false;
        setField(variantField, showVariant);
        setField(reserveField, true);
        setField(simulationField, false);
        setField(countyField, false);
        setField(localField, false);
        return;
      }

      setField(titleField, false);
      setField(variantField, false);
      setField(reserveField, false);
      if (reserveInput) reserveInput.checked = false;
      setField(simulationField, true);

      if (simulation === 'judetene') {
        setField(countyField, true);
        setField(localField, false);
      } else {
        setField(countyField, false);
        setField(localField, true);
        localField?.querySelector('input')?.setAttribute('required', 'true');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (yearInput && !yearInput.value) {
        yearInput.value = new Date().getFullYear().toString();
      }
      if (type2Toggle && type2Input) {
        type2Input.value = type2Toggle.checked ? 'bar' : 'var';
      }
      toggleFields(page, simulation, title);
    });

    pageSelect?.addEventListener('change', (e: Event) => {
      page = (e.target as HTMLSelectElement).value;
      toggleFields(page, simulation, title);
    });

    titleSelect?.addEventListener('change', (e: Event) => {
      title = (e.target as HTMLSelectElement).value;
      toggleFields(page, simulation, title);
    });

    type2Toggle?.addEventListener('change', () => {
      if (type2Toggle && type2Input) {
        type2Input.value = type2Toggle.checked ? 'bar' : 'var';
      }
    });

    simulationSelect?.addEventListener('change', (e: Event) => {
      simulation = (e.target as HTMLSelectElement).value;
      toggleFields(page, simulation, title);
    });

    const form = $('uploadForm') as HTMLFormElement | null;
    const messageDiv = $('message');
    const modal = $('passwordModal');
    const closeModal = $('closeModalBtn');
    const submitPasswordBtn = $('submitPassword') as HTMLButtonElement | null;

    if (form && messageDiv && modal && closeModal && submitPasswordBtn) {
      const passwordInput = $('passwordInput') as HTMLInputElement | null;
      const defaultLabel = submitPasswordBtn.textContent || 'Trimite';

      const setLoading = (loading: boolean): void => {
        submitPasswordBtn.disabled = loading;
        submitPasswordBtn.textContent = loading
          ? 'Se trimite...'
          : defaultLabel;
        submitPasswordBtn.classList.toggle('opacity-60', loading);
        submitPasswordBtn.classList.toggle('cursor-not-allowed', loading);
      };

      const hideModal = (): void => {
        if (passwordInput) {
          passwordInput.value = '';
          passwordInput.blur();
        }
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      form.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        if (passwordInput) {
          passwordInput.value = '';
          passwordInput.focus();
        }
      });

      closeModal.addEventListener('click', hideModal);

      window.addEventListener('click', (e: MouseEvent) => {
        if (e.target === modal) hideModal();
      });

      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          hideModal();
        }
      });

      submitPasswordBtn.addEventListener('click', async () => {
        if (submitPasswordBtn.disabled) return;
        setLoading(true);

        const password = passwordInput?.value ?? '';

        if (!password) {
          messageDiv.textContent = 'Introdu parola pentru a continua.';
          messageDiv.className = 'text-red-500';
          setLoading(false);
          return;
        }

        hideModal();

        messageDiv.textContent = 'Se încarcă...';
        messageDiv.className = 'text-blue-500';

        const formData = new FormData(form);
        if (page === 'bac') {
          formData.delete('simulation');
          formData.delete('county');
          formData.delete('local');
        } else {
          formData.delete('title');
          formData.delete('variant');
          formData.delete('reserve');
          formData.delete(simulation === 'judetene' ? 'local' : 'county');
        }

        const toBase64 = (s: string): string =>
          btoa(String.fromCharCode(...new TextEncoder().encode(s)));
        const auth = 'Bearer ' + toBase64('admin:' + password);

        const baseUrl = import.meta.env.PUBLIC_WORKER_URL.replace(/\/$/, '');

        try {
          const res = await fetch(baseUrl + '/upload', {
            method: 'POST',
            headers: { Authorization: auth },
            body: formData,
          });
          if (res.ok) {
            messageDiv.textContent = 'Fișierul a fost încărcat cu succes!';
            messageDiv.className = 'text-green-500';
          } else {
            messageDiv.textContent = 'Eroare: ' + (await res.text());
            messageDiv.className = 'text-red-500';
          }
        } catch {
          messageDiv.textContent = 'A apărut o eroare în timpul încărcării.';
          messageDiv.className = 'text-red-500';
        } finally {
          setLoading(false);
        }
      });
    }
  </script>
</Layout>
