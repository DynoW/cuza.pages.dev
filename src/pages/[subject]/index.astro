---
import NewPage from '../../components/NewPage.astro';
import { apiService } from '../../api';

export async function getStaticPaths() {
  const subjectPages = await apiService.getStructure();
  return Object.entries(subjectPages)
    .filter(([, pages]) => pages.length === 1)
    .map(([subject, pages]) => ({
      params: { subject },
      props: { firstPage: pages[0] },
    }));
}

const { subject } = Astro.params as { subject: string };
const { firstPage } = Astro.props as { firstPage: string };
---

<NewPage subject={subject} page={firstPage} />
