---
import Layout from '../layouts/Layout.astro';
import ContentContainer from '../layouts/ContentContainer.astro';
import NewNavbar from '../components/NewNavbar.astro';
import List from './List.astro';
import Extra from '../components/Extra.astro';
import Footer from '../components/Footer.astro';
import CountdownTimer from './CountdownTimer.astro';
import SiteLinks from './SiteLinks.astro';
import { apiService } from '../api';
import { getDisplayName, PAGE_DISPLAY_NAMES } from '../config/labels';
import type { FileStructure } from '../types';

// Props for the component
interface Props {
  subject: string;
  page: string;
}

const { subject, page } = Astro.props as Props;

// Single request for all page data
const [pageData, structure] = await Promise.all([
  apiService.getPageData(subject, page),
  apiService.getStructure(),
]);
const content: FileStructure = pageData.content;
const years: number[] = pageData.years;
const extra: FileStructure = pageData.extra;

// ── SEO helpers ──────────────────────────────────────────────────────────────
const school = 'Liceul Teoretic Alexandru Ioan Cuza, București';
const subjectLabel =
  subject === 'admitere' ? 'Admitere UPB' : getDisplayName(subject);
const pageLabel = PAGE_DISPLAY_NAMES[page] ?? getDisplayName(page);
const isHome = subject === 'fizica' && page === 'teoretic';
const isBac = page === 'bac';
const isAdmitere = subject === 'admitere';

const pageTitle = isHome
  ? 'Mate-Fizică BAC | cuza.pages.dev'
  : `${subjectLabel} - ${pageLabel} | cuza.pages.dev`;

function buildDescription(): string {
  if (isHome) {
    return `Arhivă cu subiecte oficiale BAC, variante și simulări la Fizică pentru liceeni. Include bareme și rezolvări pentru bacalaureat și admiterea UPB. ${school}.`;
  }
  if (isAdmitere) {
    return `Subiecte de admitere UPB și Politehnică la ${pageLabel} — variante din anii anteriori, bareme și modele de examen pentru pregătire. ${school}.`;
  }
  if (isBac) {
    return `Subiecte oficiale și variante BAC la ${subjectLabel} din sesiunile anterioare. Arhivă cu bareme și rezolvări pentru pregătirea bacalaureatului. ${school}.`;
  }
  return `Subiecte și variante ${pageLabel} la ${subjectLabel} pentru BAC și admitere. Arhivă cu bareme și rezolvări. ${school}.`;
}

function buildKeywords(): string {
  const base = `cuza, LTAIC, ${school.toLowerCase()}`;
  if (isHome) {
    return `fizică, bacalaureat, subiecte bac, variante bac, bareme, simulări, admitere UPB, pregătire bac, liceu, cuza, LTAIC`;
  }
  if (isAdmitere) {
    return `${pageLabel.toLowerCase()}, admitere UPB, politehnica, variante admitere, bareme, pregătire admitere, ${base}`;
  }
  if (isBac) {
    return `${subjectLabel.toLowerCase()}, subiecte bac, variante bac, bareme bac, bacalaureat, ${base}`;
  }
  return `${subjectLabel.toLowerCase()}, ${pageLabel.toLowerCase()}, bacalaureat, subiecte, variante, bareme, ${base}`;
}

const pageDescription = buildDescription();
const pageKeywords = buildKeywords();

const canonicalUrl = isHome
  ? 'https://cuza.pages.dev'
  : `https://cuza.pages.dev/${subject}/${page}`;

const subjectPages = structure?.[subject] ?? [];
const firstPage = subjectPages[0] ?? 'bac';
const subjectBreadcrumbUrl = isHome
  ? 'https://cuza.pages.dev'
  : `https://cuza.pages.dev/${subject}/${firstPage}`;

const breadcrumbs = [
  { name: subjectLabel, url: subjectBreadcrumbUrl },
  ...(isHome || page === firstPage
    ? []
    : [{ name: pageLabel, url: canonicalUrl }]),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <ContentContainer>
    <aside slot="left" class="flex flex-col gap-2 lg:ml-2 lg:mt-2">
      <NewNavbar />
      <SiteLinks wrapperClass="hidden lg:flex" />
    </aside>
    <div slot="middle" class="flex flex-col gap-2">
      <div class="bg-gray-100/90 rounded-3xl py-5 px-2.5 font-bold">
        <List subject={subject} page={page} content={content} />
      </div>
    </div>
    <aside
      slot="right"
      class="flex flex-col gap-2 md:mt-2 md:mr-2 md:sticky md:top-2 md:right-2"
    >
      <Extra subject={subject} page={page} extraData={extra} years={years} />
      <CountdownTimer />
    </aside>
  </ContentContainer>
  <Footer />
</Layout>
