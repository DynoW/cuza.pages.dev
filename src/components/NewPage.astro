---
import Layout from '../layouts/Layout.astro';
import ContentContainer from '../layouts/ContentContainer.astro';
import NewNavbar from '../components/NewNavbar.astro';
import List from './List.astro';
import Extra from '../components/Extra.astro';
import Footer from '../components/Footer.astro';
import CountdownTimer from './CountdownTimer.astro';
import SiteLinks from './SiteLinks.astro';
import { apiService } from '../api';
import { getFolderPriority } from '../config/labels';
import { getPageMeta, getPageTitle, getBreadcrumbs } from '../config/seo';
import type { FileStructure } from '../types';

// Helper to match List.astro folder display format
const formatFolderKey = (key: string): string => key.replace(/_/g, '-');

// Props for the component
interface Props {
  subject: string;
  page: string;
}

const { subject, page } = Astro.props as Props;

// Single request for all page data
const pageData = await apiService.getPageData(subject, page);
const content: FileStructure = pageData.content;
const years: number[] = pageData.years;
const extra: FileStructure = pageData.extra;

// Top-level non-year folder keys for sidebar shortcuts
const contentFolders = Object.entries(content)
  .filter(([, v]) => typeof v === 'object' && v !== null)
  .filter(([k]) => !/^20\d{2}$/.test(k))
  .map(([k]) => ({ key: k, label: formatFolderKey(k) }))
  .sort((a, b) => getFolderPriority(a.key) - getFolderPriority(b.key));

// ── SEO helpers ──────────────────────────────────────────────────────────────
const meta = getPageMeta(subject, page);
const pageTitle = getPageTitle(meta.title);
const pageDescription = meta.description;
const pageHeading = meta.heading;
const breadcrumbs = getBreadcrumbs(subject, page);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={meta.canonicalUrl}
  ogImage={meta.ogImage}
  ogImageAlt={meta.title}
  breadcrumbs={breadcrumbs}
  subject={subject}
  page={page}
>
  <ContentContainer>
    <aside slot="left" class="flex flex-col gap-2 lg:ml-2 lg:mt-2">
      <NewNavbar />
      <SiteLinks wrapperClass="hidden lg:flex" />
    </aside>
    <article slot="middle" aria-label={pageHeading} class="flex flex-col gap-2">
      <div class="bg-gray-100/90 rounded-3xl py-5 px-2.5 font-bold">
        <h1 class="text-xl md:text-2xl font-extrabold px-4 pb-2 text-slate-800">
          {pageHeading}
        </h1>
        <List subject={subject} page={page} content={content} />
      </div>
    </article>
    <aside
      slot="right"
      class="flex flex-col gap-2 md:mt-2 md:mr-2 md:sticky md:top-2 md:right-2"
    >
      <Extra
        subject={subject}
        page={page}
        extraData={extra}
        years={years}
        contentFolders={contentFolders}
      />
      <CountdownTimer />
    </aside>
  </ContentContainer>
  <Footer />
</Layout>
