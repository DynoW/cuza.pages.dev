---
interface FolderShortcut {
  key: string;
  label: string;
}

interface Props {
  years?: number[];
  folders?: FolderShortcut[];
}

const { years = [], folders = [] } = Astro.props;
const hasYears = years.length > 0;
const hasFolders = folders.length > 0;
if (!hasYears && !hasFolders) return;
---

<div class="shortcuts-container">
  <p class="text-lg font-bold text-slate-300">Accesare rapidă</p>

  {
    hasFolders && (
      <>
        <div class="shortcuts-grid">
          {folders.map((f) => (
            <a
              href={`#${f.key}`}
              class="shortcut-button"
              title={`Salt la secțiunea ${f.label}`}
            >
              {f.label}
            </a>
          ))}
        </div>
        {hasYears && <hr class="border-white/10 my-2" />}
      </>
    )
  }

  {
    hasYears && (
      <div class="shortcuts-grid">
        {years.map((year) => (
          <a
            href={`#${year}`}
            class="shortcut-button"
            title={`Salt la documentele din ${year}`}
          >
            {year}
          </a>
        ))}
      </div>
    )
  }
</div>

<style>
  .shortcuts-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .shortcut-button {
    background-color: #1e293b;
    color: #94a3b8;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    text-align: center;
    min-width: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .shortcut-button:hover {
    background-color: #334155;
    color: #e2e8f0;
    transform: translateY(-1px);
  }
</style>
