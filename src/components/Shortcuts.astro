---
interface FolderShortcut {
  key: string;
  label: string;
}

interface Props {
  years?: number[];
  folders?: FolderShortcut[];
}

const { years = [], folders = [] } = Astro.props;
const hasYears = years.length > 0;
const hasFolders = folders.length > 0;
if (!hasYears && !hasFolders) return;
---

<div>
  <p class="text-lg font-bold text-slate-300">Accesare rapidă</p>

  {
    hasFolders && (
      <>
        <div class="flex flex-wrap gap-2 mt-2">
          {folders.map((f) => (
            <a
              href={`#${f.key}`}
              class="shortcut-button bg-slate-800 text-slate-400 px-2 py-1 rounded text-sm transition-all duration-200 text-center min-w-12 inline-flex items-center justify-center hover:bg-slate-700 hover:text-slate-200 hover:-translate-y-px"
              title={`Salt la secțiunea ${f.label}`}
            >
              {f.label}
            </a>
          ))}
        </div>
        {hasYears && <hr class="border-white/10 my-2" />}
      </>
    )
  }

  {
    hasYears && (
      <div class="flex flex-wrap gap-2 mt-2">
        {years.map((year) => (
          <a
            href={`#${year}`}
            class="shortcut-button bg-slate-800 text-slate-400 px-2 py-1 rounded text-sm transition-all duration-200 text-center min-w-12 inline-flex items-center justify-center hover:bg-slate-700 hover:text-slate-200 hover:-translate-y-px"
            title={`Salt la documentele din ${year}`}
          >
            {year}
          </a>
        ))}
      </div>
    )
  }
</div>
