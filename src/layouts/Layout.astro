---
import { SEO } from 'astro-seo';
import UpArrow from '../icons/UpArrow.astro';
import '../styles/global.css';
import { getCollectionJsonLd } from '../config/seo';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  nofollow?: boolean;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  extendMeta?: object;
  extendLink?: object;
  backgroundImage?: boolean;
  bodyClass?: string;
  markdown?: boolean;
  breadcrumbs?: Array<{ name: string; url?: string }>;
  subject?: string;
  page?: string;
  course?: boolean;
}

const {
  title,
  description = 'Subiecte de bac și admitere UPB – arhivă open-source de variante, bareme, simulări și notițe pentru bacalaureat. Fizică, matematică, informatică și toate materiile de liceu.',
  noindex,
  nofollow,
  canonicalUrl,
  ogImage = 'https://cuza.pages.dev/open-graph/index.png',
  ogImageAlt,
  ogType = 'website',
  extendMeta,
  extendLink,
  backgroundImage = true,
  bodyClass,
  markdown,
  breadcrumbs,
  subject,
  page,
  course,
} = Astro.props;

const collectionJsonLd =
  subject && page && !course ? getCollectionJsonLd(subject, page) : null;
const month = new Date().getMonth();
let backgroundStyle = '';
const isWinterTheme = backgroundImage && month === 11;
const isSpringTheme = backgroundImage && (month === 2 || month === 3);

if (isWinterTheme) {
  backgroundStyle =
    'background: url("/assets/img/background/bg-pattern-cr.webp"), linear-gradient(to left, #330d0d, #cc3333); background-attachment: fixed;';
} else if (isSpringTheme) {
  backgroundStyle =
    'background: url("/assets/img/background/bg-pattern.webp"), linear-gradient(to top, #5c6b7e, #6091d2 23%, #7faeec 95%, #6091d2); background-attachment: fixed;';
}
---

<!doctype html>
<html lang="ro">
  <head>
    <SEO
      charset="UTF-8"
      title={title}
      description={description}
      noindex={noindex}
      nofollow={nofollow}
      canonical={canonicalUrl || Astro.url.href}
      openGraph={{
        basic: {
          title: title,
          type: ogType,
          image: ogImage,
          url: Astro.url.href,
        },
        optional: {
          description: description,
          locale: 'ro_RO',
          siteName: 'Mate-fizica',
        },
        image: {
          alt: ogImageAlt,
          width: 1200,
          height: 630,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        creator: '@DynoW',
        title: title,
        description: description,
        image: ogImage,
        imageAlt: ogImageAlt,
      }}
      extend={{
        link: [
          {
            rel: 'preload',
            href: '/assets/fonts/inter-medium.woff2',
            as: 'font',
            type: 'font/woff2',
            crossorigin: 'anonymous',
          },
          {
            rel: 'apple-touch-icon',
            type: 'image/png',
            sizes: '180x180',
            href: '/assets/img/logo/atoms_180px.png',
          },
          {
            rel: 'icon',
            type: 'image/png',
            sizes: '16x16',
            href: '/assets/img/logo/atoms_16px.png',
          },
          {
            rel: 'icon',
            type: 'image/png',
            sizes: '32x32',
            href: '/assets/img/logo/atoms_32px.png',
          },
          {
            rel: 'icon',
            type: 'image/png',
            sizes: '180x180',
            href: '/assets/img/logo/atoms_180px.png',
          },
          {
            rel: 'icon',
            type: 'image/png',
            sizes: '192x192',
            href: '/assets/img/logo/atoms_192px.png',
          },
          {
            rel: 'icon',
            type: 'image/png',
            sizes: '512x512',
            href: '/assets/img/logo/atoms_512px.png',
          },
          {
            rel: 'shortcut icon',
            type: 'image/png',
            sizes: '32x32',
            href: '/assets/img/logo/atoms_32px.png',
          },
          {
            rel: 'manifest',
            href: '/manifest.webmanifest',
          },
          {
            rel: 'sitemap',
            type: 'application/xml',
            href: '/sitemap-index.xml',
          },
          ...(markdown
            ? [
                {
                  rel: 'stylesheet',
                  href: '/assets/css/github-markdown.css',
                },
              ]
            : []),
          ...(Array.isArray(extendLink) ? extendLink : []),
        ],
        meta: [
          {
            name: 'viewport',
            content: 'width=device-width, initial-scale=1.0, shrink-to-fit=no',
          },
          {
            name: 'theme-color',
            content: '#0e1720',
          },
          {
            name: 'author',
            content: 'Liceul Teoretic Alexandru Ioan Cuza, București',
          },
          ...(Array.isArray(extendMeta) ? extendMeta : []),
        ],
      }}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': 'https://cuza.pages.dev/#website',
        name: 'CuzaPages',
        url: 'https://cuza.pages.dev',
        description:
          'Arhivă cu subiecte BAC, simulări județene, bareme și notițe pentru bacalaureat.',
        inLanguage: 'ro',
        publisher: { '@id': 'https://cuza.pages.dev/#organization' },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'EducationalOrganization',
        '@id': 'https://cuza.pages.dev/#organization',
        name: 'Liceul Teoretic Alexandru Ioan Cuza, București',
        url: 'https://laicuza.ro',
      })}
    />
    {
      breadcrumbs && (
        <>
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              '@id': 'https://cuza.pages.dev/#breadcrumb',
              itemListElement: breadcrumbs.map(
                (crumb: { name: string; url?: string }, index: number) => ({
                  '@type': 'ListItem',
                  position: index + 1,
                  name: crumb.name,
                  ...(crumb.url ? { item: crumb.url } : {}),
                }),
              ),
            })}
          />
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'WebPage',
              '@id': canonicalUrl || Astro.url.href,
              name: title,
              description: description,
              url: canonicalUrl || Astro.url.href,
              inLanguage: 'ro',
              isPartOf: {
                '@id': 'https://cuza.pages.dev/#website',
              },
              breadcrumb: {
                '@id': 'https://cuza.pages.dev/#breadcrumb',
              },
              ...(collectionJsonLd
                ? {
                    mainEntity: { '@id': 'https://cuza.pages.dev/#collection' },
                  }
                : {}),
            })}
          />
          {collectionJsonLd && (
            <script
              is:inline
              type="application/ld+json"
              set:html={JSON.stringify(collectionJsonLd)}
            />
          )}
          {course && (
            <script
              is:inline
              type="application/ld+json"
              set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Course',
                name: title.replace(/\s*\|\s*CuzaPages$/, ''),
                url: canonicalUrl || Astro.url.href,
                description,
                provider: { '@id': 'https://cuza.pages.dev/#organization' },
                inLanguage: 'ro',
              })}
            />
          )}
        </>
      )
    }
    {/* Excalidraw asset path */}
    <script is:inline>
      window.EXCALIDRAW_ASSET_PATH = '/assets';
    </script>

    {
      import.meta.env.PROD ? (
        <>
          {/* Umami tag */}
          <script
            is:inline
            defer
            src="https://analytics.my-lab.ro/script.js"
            data-website-id="a83c7c53-4f0a-4244-9c79-4166e0d67ad9"
          />
          {/* <!-- Google tag (gtag.js) --> */}
          {/* <script async src="https://www.googletagmanager.com/gtag/js?id=G-PS1EBGH4HS"></script>
                    <script is:inline>
                      window.dataLayer = window.dataLayer || [];
                      function gtag(){dataLayer.push(arguments);}
                      gtag('js', new Date());
                    
                      gtag('config', 'G-PS1EBGH4HS');
                    </script> */}
        </>
      ) : null
    }
  </head>
  <body
    class={`font-sans overflow-x-hidden relative min-h-svh p-0${backgroundImage ? ' backgroundImage' : ''}${bodyClass ? ` ${bodyClass}` : ''}`}
    style={backgroundStyle}
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:text-slate-900 focus:p-3 focus:rounded-lg"
      >Sari la conținut</a
    >
    <slot />
    {
      isSpringTheme && (
        <>
          <div class="clouds" />
          <div class="bunny" />
          <div class="grass" />
        </>
      )
    }
    <div class="fixed bottom-10 right-4">
      <button
        id="scrollToTop"
        title="Deruleaza sus"
        aria-label="Deruleaza sus"
        type="button"
        class="bg-white font-bold p-4 rounded-full transition ease-in-out hover:scale-105 duration-200 cursor-pointer"
        style="display: none;"
      >
        <UpArrow />
      </button>
      <script is:inline>
        const button = document.getElementById('scrollToTop');
        function scrollToTop() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        button.addEventListener('click', scrollToTop);
        window.addEventListener('scroll', function () {
          if (button) {
            button.style.display = window.scrollY > 0 ? 'block' : 'none';
          }
        });
      </script>
    </div>
    {
      import.meta.env.PROD && (
        <script is:inline>
          if ('serviceWorker' in navigator)
          navigator.serviceWorker.register('/sw.js')
        </script>
      )
    }
    {
      // <script>
      //   // Tab visibility title change
      //   const _originalTitle = document.title;
      //   document.addEventListener('visibilitychange', () => {
      //     document.title = document.hidden ? 'Cuza Hub 😉' : _originalTitle;
      //   });
      // </script>
    }
    {
      // <script>
      //   // Build-time season picks initial theme, then client-side corrects stale builds.
      //   const backgroundImageElement = document.querySelector(".backgroundImage");
      //   if (backgroundImageElement instanceof HTMLElement) {
      //     const removeSpringLayers = () => {
      //       document
      //         .querySelectorAll(".clouds, .bunny, .grass")
      //         .forEach((element) => element.remove());
      //     };
      //     const ensureSpringLayers = () => {
      //       const body = document.body;
      //       if (!body) return;
      //       ["clouds", "bunny", "grass"].forEach((className) => {
      //         if (!document.querySelector(`.${className}`)) {
      //           const element = document.createElement("div");
      //           element.className = className;
      //           body.appendChild(element);
      //         }
      //       });
      //     };
      //     const month = new Date().getMonth();
      //     if (month === 11) {
      //       backgroundImageElement.style.background =
      //         'url("/assets/img/background/bg-pattern-cr.webp"), linear-gradient(to left, #330d0d, #cc3333)';
      //       backgroundImageElement.style.backgroundAttachment = "fixed";
      //       removeSpringLayers();
      //     } else if (month === 2 || month === 3) {
      //       backgroundImageElement.style.background =
      //         'url("/assets/img/background/bg-pattern.webp"), linear-gradient(to top, #5c6b7e, #6091d2 23%, #7faeec 95%, #6091d2)';
      //       backgroundImageElement.style.backgroundAttachment = "fixed";
      //       ensureSpringLayers();
      //     } else {
      //       // Revert to default CSS theme outside seasonal windows.
      //       backgroundImageElement.style.background = "";
      //       backgroundImageElement.style.backgroundAttachment = "";
      //       removeSpringLayers();
      //     }
      //   }
      // </script>
    }
  </body>
</html>
